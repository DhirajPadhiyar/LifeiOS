@using LifeiOS.Models

@{
    ViewData["Title"] = "Global Search";

    var searchTerm = ViewBag.SearchTerm as string;

    var tasks = ViewBag.Tasks as List<TaskItem> ?? new();
    var notes = ViewBag.Notes as List<Note> ?? new();
    var goals = ViewBag.Goals as List<Goal> ?? new();
    var habits = ViewBag.Habits as List<Habit> ?? new();
    var expenses = ViewBag.Expenses as List<Expense> ?? new();
    var eventsList = ViewBag.Events as List<CalendarEvent> ?? new();

    bool hasResults =
        tasks.Any() ||
        notes.Any() ||
        goals.Any() ||
        habits.Any() ||
        expenses.Any() ||
        eventsList.Any();
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">Global Search</h2>
        <p class="text-muted mb-0">
            Search across your entire LifeOS.
        </p>
    </div>

</div>

<form asp-action="Index" method="get" class="mb-4">

    <div class="notes-search mb-3">

        <input type="text"
               name="searchTerm"
               value="@searchTerm"
               class="form-control-custom"
               placeholder="Search Tasks, Notes, Goals, Habits, Expenses, Calendar..." />

        <button type="submit" class="btn-search">
            <i class="bi bi-search"></i>
        </button>

    </div>

    @if (!string.IsNullOrWhiteSpace(searchTerm))
    {
        <div class="mb-3">

            <a asp-action="Index"
               class="btn btn-secondary-custom">

                <i class="bi bi-arrow-counterclockwise me-2"></i>
                Reset

            </a>

        </div>
    }

</form>
@if (!string.IsNullOrWhiteSpace(searchTerm))
{
    <p class="text-muted mb-4">
        Found <strong>@ViewBag.TotalResults</strong> result(s) for
        "<strong>@searchTerm</strong>"
    </p>
}

@if (string.IsNullOrWhiteSpace(searchTerm))
{
    <div class="card-custom text-center p-5">

        <i class="bi bi-search fs-1 text-primary"></i>

        <h4 class="mt-3">
            Start Searching
        </h4>

        <p class="text-muted mb-0">
            Search anything inside your LifeOS.
        </p>

    </div>

    return;
}

@if (!hasResults)
{
    <div class="card-custom text-center p-5">

        <i class="bi bi-search fs-1 text-secondary"></i>

        <h4 class="mt-3">
            No Results Found
        </h4>

        <p class="text-muted mb-0">
            We couldn't find anything matching
            "<strong>@searchTerm</strong>"
        </p>

    </div>

    return;
}

@if (tasks.Any())
{
    <div class="card-custom mb-4">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h5 class="mb-0">
                <i class="bi bi-list-task text-primary"></i>
                Tasks
            </h5>

            <span class="badge rounded-pill bg-black">
                @ViewBag.TaskTotal
            </span>

        </div>

        @foreach (var item in tasks)
        {
            <div class="d-flex justify-content-between align-items-center border-bottom py-2">

                <div>

                    <div class="fw-semibold">
                        @item.Title
                    </div>

                    <small class="text-muted">
                        Task
                    </small>

                </div>

                <a asp-controller="Tasks"
                   asp-action="Details"
                   asp-route-id="@item.Id"
                   class="btn btn-sm btn-outline-custom">
                    View
                </a>

            </div>
        }

    </div>
}

