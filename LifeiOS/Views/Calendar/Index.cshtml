@model IEnumerable<LifeiOS.Models.CalendarEvent>

@{
    ViewData["Title"] = "Calendar";
}
<div class="d-flex justify-content-between align-items-start mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Calendar
        </h2>

        <p class="text-muted mb-0">
            Manage your events and schedule.
        </p>

    </div>

    <a asp-action="Create"
       class="btn btn-primary-custom">

        <i class="bi bi-plus-lg me-2"></i>

        Add Event

    </a>

</div>

<div class="d-flex justify-content-center mb-4">

    <div class="calendar-view-switch">

        <a asp-action="Index"
           asp-route-viewMode="list"
           class="@(ViewBag.ViewMode == "list" ? "active" : "")">

            <i class="bi bi-list-ul me-2"></i>

            List

        </a>

        <a asp-action="Index"
           asp-route-viewMode="month"
           class="@(ViewBag.ViewMode == "month" ? "active" : "")">

            <i class="bi bi-calendar3 me-2"></i>

            Month

        </a>

    </div>

</div>
@if (ViewBag.ViewMode == "list")
{
    <form asp-action="Index"
    method="get"
    class="notes-toolbar">

        <div class="notes-search">

            <input type="text"
            name="searchString"
            value="@ViewBag.SearchString"
            class="form-control-custom"
            placeholder="Search events..." />

            <button type="submit"
            class="btn-search">

                <i class="bi bi-search"></i>

            </button>

        </div>

        <div>

            <a asp-action="Index"
            class="btn btn-secondary-custom">

                <i class="bi bi-arrow-counterclockwise me-2"></i>

                Reset

            </a>

        </div>

    </form>
    <div class="category-chips mb-4">

        <a asp-action="Index"
           class="chip @(string.IsNullOrEmpty(ViewBag.Filter) ? "chip-active" : "")">
            All
        </a>

        <a asp-action="Index"
           asp-route-filter="today"
           class="chip @(ViewBag.Filter == "today" ? "chip-active" : "")">
            Today
        </a>

        <a asp-action="Index"
           asp-route-filter="week"
           class="chip @(ViewBag.Filter == "week" ? "chip-active" : "")">
            This Week
        </a>

        <a asp-action="Index"
           asp-route-filter="month"
           class="chip @(ViewBag.Filter == "month" ? "chip-active" : "")">
            This Month
        </a>

        <a asp-action="Index"
           asp-route-filter="upcoming"
           class="chip @(ViewBag.Filter == "upcoming" ? "chip-active" : "")">
            Upcoming
        </a>

    </div>
}



@if (ViewBag.ViewMode == "list")
{
    @if (!Model.Any())
    {
        <div class="card-custom text-center py-5">

            <i class="bi bi-calendar3 display-1 text-muted"></i>

            <h4 class="mt-4 fw-bold">
                No Events Found
            </h4>

            <p class="text-muted mb-4">
                Create your first event to organize your schedule.
            </p>

            <a asp-action="Create"
               class="btn btn-primary-custom">

                <i class="bi bi-plus-lg me-2"></i>

                Create First Event

            </a>

        </div>
    }
    else
    {
        <div class="row g-4 mt-2">

            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6">

                    <div class="card-custom calendar-card h-100 d-flex flex-column"
                         style="border-left:5px solid @(string.IsNullOrWhiteSpace(item.Color) ? "#2563EB" : item.Color)">

                        <div class="calendar-card-header">

                            <h5 class="calendar-event-title mb-0">
                                @item.Title
                            </h5>

                            <div class="dropdown">

                                <button class="action-menu-btn"
                                        type="button"
                                        data-bs-toggle="dropdown">

                                    <i class="bi bi-three-dots-vertical"></i>

                                </button>

                                <ul class="dropdown-menu dropdown-menu-end action-dropdown">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-action="Details"
                                           asp-route-id="@item.Id">

                                            <i class="bi bi-eye me-2"></i>
                                            View

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id">

                                            <i class="bi bi-pencil me-2"></i>
                                            Edit

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item text-danger"
                                           asp-action="Delete"
                                           asp-route-id="@item.Id">

                                            <i class="bi bi-trash me-2"></i>
                                            Delete

                                        </a>
                                    </li>

                                </ul>

                            </div>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <p class="text-muted mt-3 flex-grow-1">

                                @item.Description

                            </p>
                        }

                        <hr />

                        <div class="small">

                            <div class="mb-2">

                                <i class="bi bi-calendar-event me-2 text-primary"></i>

                                @item.StartDate.ToString("dd MMM yyyy")

                            </div>

                            <div class="mb-2">

                                <i class="bi bi-clock me-2 text-primary"></i>

                                @item.StartDate.ToString("hh:mm tt")

                                -

                                @item.EndDate.ToString("hh:mm tt")

                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3">

                                @if (item.IsAllDay)
                                {
                                    <span class="badge bg-success">

                                        All Day

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">

                                        Scheduled

                                    </span>
                                }

                                <small class="text-muted">

                                    Created

                                    @item.CreatedAt.ToString("dd MMM")

                                </small>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    @if (ViewBag.TotalPages > 1)
    {
        <nav class="mt-4">

            <ul class="pagination justify-content-center">

                <!-- Previous -->

                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage - 1)"
                       asp-route-searchString="@ViewBag.SearchString"
                       asp-route-filter="@ViewBag.Filter"
                       asp-route-sortOrder="@ViewBag.SortOrder">

                        Previous

                    </a>

                </li>

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-searchString="@ViewBag.SearchString"
                           asp-route-filter="@ViewBag.Filter"
                           asp-route-sortOrder="@ViewBag.SortOrder">

                            @i

                        </a>

                    </li>
                }

                <!-- Next -->

                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-searchString="@ViewBag.SearchString"
                       asp-route-filter="@ViewBag.Filter"
                       asp-route-sortOrder="@ViewBag.SortOrder">

                        Next

                    </a>

                </li>

            </ul>

        </nav>
    }
}
@if (ViewBag.ViewMode == "month")
{
    <partial name="_MonthCalendar"
             model="Model" />
}
