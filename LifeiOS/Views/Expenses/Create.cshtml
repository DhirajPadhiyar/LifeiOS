@model LifeiOS.Models.Expense

@{
    ViewData["Title"] = "Add Expense";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold mb-1">Add Expense</h2>

        <p class="text-muted mb-0">
            Record a new expense to keep your finances organized.
        </p>

    </div>

    <a asp-action="Index" class="btn btn-secondary-custom">

        <i class="bi bi-arrow-left me-2"></i>

        Back

    </a>

</div>

<div class="card-custom">

    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert">
        </div>

        <div class="row">

            <div class="col-md-6 mb-3">

                <label asp-for="Title" class="form-label"></label>

                <input asp-for="Title" class="form-control-custom" placeholder="Expense title" />

                <span asp-validation-for="Title" class="text-danger small"></span>

            </div>

            <div class="col-md-6 mb-3">

                <label asp-for="Amount" class="form-label"></label>

                <input asp-for="Amount"
                       class="form-control-custom"
                       type="number"
                       step="0.01"
                       min="0.01"
                       placeholder="0.00" />

                <span asp-validation-for="Amount" class="text-danger small"></span>

            </div>

            <div class="col-md-6 mb-3">

                <label asp-for="Category" class="form-label"></label>

                <select asp-for="Category" class="form-select-custom">

                    <option value="">Select Category</option>

                    <option>Food</option>
                    <option>Transport</option>
                    <option>Shopping</option>
                    <option>Bills</option>
                    <option>Health</option>
                    <option>Education</option>
                    <option>Entertainment</option>
                    <option>Travel</option>
                    <option>Investment</option>
                    <option>Subscription</option>
                    <option>Personal</option>
                    <option>Business</option>
                    <option>Other</option>

                </select>

                <span asp-validation-for="Category" class="text-danger small"></span>

            </div>

            <div class="col-md-6 mb-3">

                <label asp-for="ExpenseDate" class="form-label"></label>

                <input asp-for="ExpenseDate"
                       class="form-control-custom"
                       type="date" />

                <span asp-validation-for="ExpenseDate" class="text-danger small"></span>

            </div>

            <div class="col-12 mb-4">

                <label asp-for="Notes" class="form-label"></label>

                <textarea asp-for="Notes"
                          rows="4"
                          class="form-control-custom"
                          placeholder="Optional notes..."></textarea>

                <span asp-validation-for="Notes" class="text-danger small"></span>

            </div>

        </div>

        <div class="d-flex gap-2">

            <button type="submit" class="btn-custom btn-primary-custom">

                <i class="bi bi-check-circle me-2"></i>

                Save Expense

            </button>

            <a asp-action="Index" class="btn-custom btn-secondary-custom">

                Cancel

            </a>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}