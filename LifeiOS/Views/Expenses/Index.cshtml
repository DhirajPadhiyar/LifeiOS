@model IEnumerable<LifeiOS.Models.Expense>

@{
    ViewData["Title"] = "Expenses";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="page-title">Expenses</h2>

        <p class="page-subtitle">
            Track your daily expenses and manage your finances.
        </p>

    </div>

    <a asp-action="Create" class="btn btn-primary-custom">
        <i class="bi bi-plus-lg me-2"></i>
        Add Expense
    </a>

</div>

<form asp-action="Index"
      method="get"
      class="notes-toolbar">

    <div class="notes-search">

        <input type="text"
               name="searchString"
               value="@ViewBag.SearchString"
               class="form-control-custom"
               placeholder="Search expenses..." />

        <button type="submit"
                class="btn-search">

            <i class="bi bi-search"></i>

        </button>

    </div>

    <div>

        <a asp-action="Index"
           class="btn btn-secondary-custom">

            <i class="bi bi-arrow-counterclockwise me-2"></i>

            Reset

        </a>

    </div>

</form>
<div class="category-filter mb-4">

    <a asp-action="Index"
       asp-route-searchString="@ViewBag.SearchString"
       class="category-chip @(string.IsNullOrEmpty(ViewBag.CurrentCategory) ? "active" : "")">

        All

    </a>

    @foreach (var item in (List<string>)ViewBag.Categories)
    {
        <a asp-action="Index"
           asp-route-category="@item"
           asp-route-searchString="@ViewBag.SearchString"
           class="category-chip @(ViewBag.CurrentCategory == item ? "active" : "")">

            @item

        </a>
    }

</div>
<div class="row g-3 my-4">

    <div class="col-lg-3 col-md-6">

        <div class="dashboard-card">

            <div class="dashboard-card-icon summary-primary">
                <i class="bi bi-wallet2"></i>
            </div>

            <div class="dashboard-statss">

               

                <h3>@ViewBag.TotalExpenses.ToString("N2")</h3>

                <p>Total Expenses</p>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="dashboard-card">

            <div class="dashboard-card-icon summary-success">
                <i class="bi bi-calendar-month"></i>
            </div>

            <div class="dashboard-statss">

                <h3>
                   
                    @ViewBag.ThisMonthExpenses.ToString("N2")
                </h3>

                <p>This Month</p>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="dashboard-card">

            <div class="dashboard-card-icon summary-warning">
                <i class="bi bi-calendar-day"></i>
            </div>

            <div class="dashboard-statss">

                

                <h3>@ViewBag.TodayExpenses.ToString("N2")</h3>

                <p>Today</p>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="dashboard-card">

            <div class="dashboard-card-icon summary-danger">
                <i class="bi bi-receipt"></i>
            </div>

            <div class="dashboard-statss">

                <h3 class="text-center">@ViewBag.TotalTransactions</h3>

                <p>Transactions</p>

            </div>

        </div>

    </div>

</div>
@if (!Model.Any())
{
    <div class="card-custom text-center py-5">

        <i class="bi bi-wallet2 display-1 text-muted"></i>

        <h4 class="mt-4 fw-bold">
            No Expenses Found
        </h4>

        <p class="text-muted mb-4">
            Start tracking your expenses to better understand your spending.
        </p>

        <a asp-action="Create" class="btn btn-primary-custom">

            <i class="bi bi-plus-lg me-2"></i>

            Add First Expense

        </a>

    </div>
}
else
{
    <div class="card-custom">

        @* <div class="table-responsive"> *@

            <table class="table align-middle mb-0">

                <thead>

                    <tr>

                    <th>

                        <a asp-action="Index"
                           asp-route-sortOrder="@ViewBag.TitleSort"
                           asp-route-searchString="@ViewBag.SearchString"
                           asp-route-category="@ViewBag.CurrentCategory">

                            Title

                            <i class="bi bi-arrow-down-up ms-1"></i>

                        </a>

                    </th>

                        <th>Category</th>

                    <th>

                        <a asp-action="Index"
                           asp-route-sortOrder="@ViewBag.AmountSort"
                           asp-route-searchString="@ViewBag.SearchString"
                           asp-route-category="@ViewBag.CurrentCategory">

                            Amount

                            <i class="bi bi-arrow-down-up ms-1"></i>

                        </a>

                    </th>

                    <th>

                        <a asp-action="Index"
                           asp-route-sortOrder="@ViewBag.DateSort"
                           asp-route-searchString="@ViewBag.SearchString"
                           asp-route-category="@ViewBag.CurrentCategory">

                            Expense Date

                            <i class="bi bi-arrow-down-up ms-1"></i>

                        </a>

                    </th>

                        <th>Action</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var expense in Model)
                    {
                        <tr>

                            <td>

                                <strong>@expense.Title</strong>

                            </td>

                            <td>

                                <span class="badge bg-light text-dark">

                                    @expense.Category

                                </span>

                            </td>

                            <td class="fw-bold text-danger">

                                @expense.Amount.ToString("N2")

                            </td>

                            <td>

                                @expense.ExpenseDate.ToString("dd MMM yyyy")

                            </td>

                            <td class="text-end">

                                <div class="dropdown">

                                    <button class="action-menu-btn"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            data-bs-display="static">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end action-dropdown">

                                        <li>
                                            <a class="dropdown-item"
                                               asp-action="Details"
                                               asp-route-id="@expense.Id">

                                                <i class="bi bi-eye me-2"></i>

                                                View

                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-action="Edit"
                                               asp-route-id="@expense.Id">

                                                <i class="bi bi-pencil me-2"></i>

                                                Edit

                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item text-danger"
                                               asp-action="Delete"
                                               asp-route-id="@expense.Id">

                                                <i class="bi bi-trash me-2"></i>

                                                Delete

                                            </a>
                                        </li>

                                    </ul>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        @* </div> *@

    </div>
}
@if (ViewBag.TotalPages > 1)
{
    <nav class="mt-4">

        <ul class="pagination justify-content-center">

            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-sortOrder="@ViewBag.CurrentSort"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-searchString="@ViewBag.SearchString"
                   asp-route-category="@ViewBag.Category">

                    Previous

                </a>

            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-sortOrder="@ViewBag.CurrentSort"
                       asp-route-searchString="@ViewBag.SearchString"
                       asp-route-category="@ViewBag.Category">

                        @i

                    </a>

                </li>
            }

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-sortOrder="@ViewBag.CurrentSort"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-searchString="@ViewBag.SearchString"
                   asp-route-category="@ViewBag.Category">

                    Next

                </a>

            </li>

        </ul>

    </nav>
}