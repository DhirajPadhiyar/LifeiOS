@model LifeiOS.Models.Habit

@{
    ViewData["Title"] = "Create Habit";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold mb-1">Create Habit</h2>

        <p class="text-muted mb-0">
            Create a new habit and build consistency every day.
        </p>

    </div>

    <a asp-action="Index"
       class="btn btn-secondary-custom">

        <i class="bi bi-arrow-left me-2"></i>

        Back

    </a>

</div>

<div class="card-custom">

    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert">
        </div>

        <div class="row">

            <!-- Habit Name -->

            <div class="col-md-6 mb-4">

                <label asp-for="Name" class="form-label fw-semibold">
                </label>

                <input asp-for="Name"
                       class="form-control-custom"
                       placeholder="Enter habit name" />

                <span asp-validation-for="Name"
                      class="text-danger small">
                </span>

            </div>

            <!-- Frequency -->

            <div class="col-md-6 mb-4">

                <label asp-for="Frequency"
                       class="form-label fw-semibold">
                </label>

                <select asp-for="Frequency"
                        asp-items="Html.GetEnumSelectList<HabitFrequency>()"
                        class="form-select-custom">
                </select>

                <span asp-validation-for="Frequency"
                      class="text-danger small">
                </span>

            </div>

        </div>

        <!-- Description -->

        <div class="mb-4">

            <label asp-for="Description"
                   class="form-label fw-semibold">
            </label>

            <textarea asp-for="Description"
                      rows="5"
                      class="form-control-custom"
                      placeholder="Write a short description...">
            </textarea>

            <span asp-validation-for="Description"
                  class="text-danger small">
            </span>

        </div>

        <hr />

        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn-custom btn-primary-custom">

                <i class="bi bi-check-circle me-2"></i>

                Save Habit

            </button>

            <a asp-action="Index"
               class="btn-custom btn-secondary-custom">

                Cancel

            </a>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}