@model IEnumerable<LifeiOS.Models.Habit>

@{
    ViewData["Title"] = "Habits";
}

<!-- Page Header -->

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold mb-1">Habits</h2>

        <p class="text-muted mb-0">
            Build better routines and stay consistent every day.
        </p>

    </div>

    <a asp-action="Create"
       class="btn btn-primary-custom">

        <i class="bi bi-plus-lg me-2"></i>

        Create Habit

    </a>

</div>

<!-- Search -->

<form asp-action="Index"
      method="get"
      class="notes-toolbar">

    <div class="notes-search">

        <input type="text"
               name="searchString"
               value="@ViewBag.SearchString"
               class="form-control-custom"
               placeholder="Search habits..." />

        <button type="submit"
                class="btn-search">

            <i class="bi bi-search"></i>

        </button>

    </div>

    <div>

        <a asp-action="Index"
           class="btn btn-secondary-custom">

            <i class="bi bi-arrow-counterclockwise me-2"></i>

            Reset

        </a>

    </div>

</form>
<!-- Filter Chips -->

<div class="category-chips mb-4">

    <a asp-action="Index"
       asp-route-searchString="@ViewBag.SearchString"
       class="chip @(string.IsNullOrEmpty(ViewBag.Status) ? "chip-active" : "")">

        All

    </a>

    <a asp-action="Index"
       asp-route-status="completed"
       asp-route-searchString="@ViewBag.SearchString"
       class="chip @(ViewBag.Status == "completed" ? "chip-active" : "")">

        Completed Today

    </a>

    <a asp-action="Index"
       asp-route-status="pending"
       asp-route-searchString="@ViewBag.SearchString"
       class="chip @(ViewBag.Status == "pending" ? "chip-active" : "")">

        Pending

    </a>

    <a asp-action="Index"
       asp-route-status="daily"
       asp-route-searchString="@ViewBag.SearchString"
       class="chip @(ViewBag.Status == "daily" ? "chip-active" : "")">

        Daily

    </a>

    <a asp-action="Index"
       asp-route-status="weekly"
       asp-route-searchString="@ViewBag.SearchString"
       class="chip @(ViewBag.Status == "weekly" ? "chip-active" : "")">

        Weekly

    </a>

</div>

<!-- Statistics -->

<div class="row g-3 mb-4">

    <div class="col-md-3">

        <div class="dashboard-card">

            <div class="dashboard-card-icon summary-primary">

                <i class="bi bi-check2-square"></i>

            </div>

            <div class="dashboard-stats">

                <h3>@ViewBag.TotalHabits</h3>

                <p>Total Habits</p>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="dashboard-card">

            <div class="dashboard-card-icon summary-success">

                <i class="bi bi-check-circle"></i>

            </div>

            <div class="dashboard-stats">

                <h3 id="completed-today-count">@ViewBag.CompletedToday</h3>

                <p>Completed Today</p>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="dashboard-card">

            <div class="dashboard-card-icon summary-warning">

                <i class="bi bi-hourglass-split"></i>

            </div>

            <div class="dashboard-stats">

                <h3 id="pending-today-count">@ViewBag.PendingToday</h3>

                <p>Pending Today</p>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="dashboard-card">

            <div class="dashboard-card-icon summary-danger">

                <i class="bi bi-fire"></i>

            </div>

            <div class="dashboard-stats">

                <h3 id="best-streak-count">@ViewBag.BestStreak</h3>

                <p>Best Streak</p>

            </div>

        </div>

    </div>

</div>

<div id="habit-list-container">

    @await Html.PartialAsync(
        "_HabitList",
        Model
    )

</div>


<script>

    document.addEventListener("click", async function (event) {

        const button = event.target.closest(".complete-habit-btn");

        if (!button) {
            return;
        }

            const habitId = button.dataset.id;
            const frequency = button.dataset.frequency;

            // Prevent double click
            if (button.disabled) {
                return;
            }

            // Save original button content
            const originalButtonContent = button.innerHTML;

            // Loading state
            button.disabled = true;

            button.innerHTML =
                `<span class="spinner-border spinner-border-sm me-2"
                       role="status"
                       aria-hidden="true"></span>
                 Completing...`;

            const token = document.querySelector(
                'input[name="__RequestVerificationToken"]'
            ).value;

            try {

                const response = await fetch(
                    `/Habits/CompleteToday/${habitId}`,
                    {
                        method: "POST",

                        headers: {
                            "RequestVerificationToken": token
                        }
                    }
                );

                if (!response.ok) {
                    throw new Error("Request failed.");
                }

                const data = await response.json();

                if (!data.success) {
                    throw new Error(
                        data.message || "Unable to complete habit."
                    );
                }

                // --------------------------------
                // 1. Update Button
                // --------------------------------

                button.classList.remove("btn-primary-custom");

                button.classList.add("btn-success-custom");

                button.innerHTML =
                    `<i class="bi bi-check-circle-fill me-2"></i>
                     ${frequency === "daily"
                        ? "Completed Today"
                        : "Completed This Week"}`;

                button.disabled = true;


                // --------------------------------
                // 2. Update Streak
                // --------------------------------

                const streakElement =
                    document.getElementById(`streak-${habitId}`);

                if (streakElement) {

                    streakElement.innerHTML =
                        `🔥 ${data.streak} Day Streak`;

                }


                // --------------------------------
                // 3. Update Last Completed
                // --------------------------------

                const completedElement =
                    document.getElementById(`completed-${habitId}`);

                if (completedElement) {

                    completedElement.className =
                        "badge bg-success";

                    completedElement.innerHTML =
                        frequency === "daily"
                            ? "Today"
                            : "This Week";

                }


                // --------------------------------
                // 4. Update Card
                // --------------------------------

                const card =
                    document.getElementById(`habit-card-${habitId}`);

                if (card) {

                    card.classList.add("completed-habit");

                    const cardColumn = card.parentElement;

                    const cardsContainer = cardColumn.parentElement;

                    cardsContainer.appendChild(cardColumn);

                }


                // --------------------------------
                // 5. Update Statistics
                // --------------------------------

                const completedTodayCount =
                    document.getElementById("completed-today-count");

                const pendingTodayCount =
                    document.getElementById("pending-today-count");

                const bestStreakCount =
                    document.getElementById("best-streak-count");


                if (completedTodayCount) {

                    completedTodayCount.textContent =
                        parseInt(completedTodayCount.textContent) + 1;

                }


                if (pendingTodayCount) {

                    pendingTodayCount.textContent =
                        Math.max(
                            0,
                            parseInt(pendingTodayCount.textContent) - 1
                        );

                }


                if (bestStreakCount && data.streak) {

                    const currentBest =
                        parseInt(bestStreakCount.textContent);

                    if (data.streak > currentBest) {

                        bestStreakCount.textContent =
                            data.streak;

                    }

                }

            }
              catch (error) {

        console.error(
            "Habit completion error:",
            error
        );

        // Restore button
        button.disabled = false;

        button.innerHTML = originalButtonContent;

        alert(
            "Something went wrong. Please try again."
        );

    }

    });

</script>

<script>

    document.addEventListener("click", async function (event) {

        const paginationLink =
            event.target.closest(".habit-pagination-link");

        if (!paginationLink) {
            return;
        }

        event.preventDefault();

        const url = paginationLink.href;

        const container =
            document.getElementById("habit-list-container");

        if (!container) {
            return;
        }

        try {

            container.style.opacity = "0.5";

            const response = await fetch(url, {

                method: "GET",

                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                }

            });

            if (!response.ok) {
                throw new Error("Pagination request failed.");
            }

            const html = await response.text();

            container.innerHTML = html;

            container.style.opacity = "1";

        }
        catch (error) {

            console.error(
                "Pagination error:",
                error
            );

            container.style.opacity = "1";

            alert(
                "Unable to load habits. Please try again."
            );

        }

    });

</script>