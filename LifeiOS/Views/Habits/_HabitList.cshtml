@model IEnumerable<LifeiOS.Models.Habit>

@if (!Model.Any())
{
    <div class="card-custom text-center py-5">

        <i class="bi bi-list-check display-1 text-muted"></i>

        <h4 class="mt-4 fw-bold">
            No Habits Found
        </h4>

        <p class="text-muted mb-4">
            Create your first habit and start building better daily routines.
        </p>

        <a asp-action="Create"
           class="btn btn-primary-custom">

            <i class="bi bi-plus-lg me-2"></i>

            Create First Habit

        </a>

    </div>
}
else
{
    <div class="row g-4">

        @foreach (var habit in Model)
        {
            <div class="col-lg-4 col-md-6">

                <div id="habit-card-@habit.Id"
                     class="card-custom habit-card h-100 d-flex flex-column
                    @(habit.LastCompletedDate?.Date == DateTime.Today ? "completed-habit" : "")">

                    <!-- Header -->

                    <div class="d-flex justify-content-between align-items-start mb-3">

                        <div>

                            <h5 class="fw-bold mb-1">
                                @habit.Name
                            </h5>

                            @if (habit.Frequency == HabitFrequency.Daily)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-calendar-day me-1"></i>
                                    Daily
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    <i class="bi bi-calendar-week me-1"></i>
                                    Weekly
                                </span>
                            }

                        </div>

                        <div class="dropdown">

                            <button class="action-menu-btn"
                                    type="button"
                                    data-bs-toggle="dropdown">

                                <i class="bi bi-three-dots-vertical"></i>

                            </button>

                            <ul class="dropdown-menu dropdown-menu-end action-dropdown">

                                <li>
                                    <a class="dropdown-item"
                                       asp-action="Details"
                                       asp-route-id="@habit.Id">

                                        <i class="bi bi-eye me-2"></i>
                                        View

                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-action="Edit"
                                       asp-route-id="@habit.Id">

                                        <i class="bi bi-pencil me-2"></i>
                                        Edit

                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item text-danger"
                                       asp-action="Delete"
                                       asp-route-id="@habit.Id">

                                        <i class="bi bi-trash me-2"></i>
                                        Delete

                                    </a>
                                </li>

                            </ul>

                        </div>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(habit.Description))
                    {
                        <p class="text-muted flex-grow-1">
                            @habit.Description
                        </p>
                    }
                    else
                    {
                        <p class="text-muted flex-grow-1">
                            No description added yet.
                        </p>
                    }


                    <hr />


                    <div class="small">

                        <div class="d-flex justify-content-between mb-2">

                            <span class="text-muted">
                                Current Streak
                            </span>

                            <span id="streak-@habit.Id"
                                  class="badge bg-danger">

                                🔥 @habit.CurrentStreak Day Streak

                            </span>

                        </div>


                        <div class="d-flex justify-content-between">

                            <span class="text-muted">
                                Last Completed
                            </span>

                            @{
                                var weekStart = DateTime.Today.AddDays(
                                    -((7 + (DateTime.Today.DayOfWeek - DayOfWeek.Monday)) % 7)
                                );
                            }


                            @if (habit.LastCompletedDate == null)
                            {
                                <span class="text-muted">
                                    Never
                                </span>
                            }
                            else if (habit.Frequency == HabitFrequency.Daily)
                            {
                                if (habit.LastCompletedDate.Value.Date == DateTime.Today)
                                {
                                    <span id="completed-@habit.Id"
                                          class="badge bg-success">

                                        Today

                                    </span>
                                }
                                else if (habit.LastCompletedDate.Value.Date == DateTime.Today.AddDays(-1))
                                {
                                    <span id="completed-@habit.Id"
                                          class="badge bg-warning text-dark">

                                        Yesterday

                                    </span>
                                }
                                else
                                {
                                    <span id="completed-@habit.Id">

                                        @habit.LastCompletedDate.Value.ToString("dd MMM yyyy")

                                    </span>
                                }
                            }
                            else
                            {
                                if (habit.LastCompletedDate.Value.Date >= weekStart)
                                {
                                    <span id="completed-@habit.Id"
                                          class="badge bg-success">

                                        This Week

                                    </span>
                                }
                                else
                                {
                                    <span id="completed-@habit.Id">

                                        @habit.LastCompletedDate.Value.ToString("dd MMM yyyy")

                                    </span>
                                }
                            }

                        </div>

                    </div>


                    <div class="mt-4">

                        @{
                            bool isCompleted =
                                habit.Frequency == HabitFrequency.Daily
                                    ? habit.LastCompletedDate?.Date == DateTime.Today
                                    : habit.LastCompletedDate.HasValue &&
                                      habit.LastCompletedDate.Value.Date >= weekStart;
                        }


                        @if (isCompleted)
                        {
                            <button class="btn btn-success-custom w-100"
                                    disabled>

                                <i class="bi bi-check-circle-fill me-2"></i>

                                @(habit.Frequency == HabitFrequency.Daily
                                    ? "Completed Today"
                                    : "Completed This Week")

                            </button>
                        }
                        else
                        {
                            @Html.AntiForgeryToken()

                            <button type="button"
                                    class="btn btn-primary-custom w-100 complete-habit-btn"
                                    data-id="@habit.Id"
                                    data-frequency="@(habit.Frequency == HabitFrequency.Daily ? "daily" : "weekly")">

                                <i class="bi bi-check-circle me-2"></i>

                                @(habit.Frequency == HabitFrequency.Daily
                                    ? "Complete Today"
                                    : "Complete This Week")

                            </button>
                        }

                    </div>

                </div>

            </div>
        }

    </div>
}


@if (ViewBag.TotalPages > 1)
{
    <nav class="mt-4">

        <ul class="pagination justify-content-center">

            <!-- Previous -->

            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">

                <a class="page-link habit-pagination-link"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-searchString="@ViewBag.SearchString"
                   asp-route-status="@ViewBag.Status">

                    Previous

                </a>

            </li>


            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">

                    <a class="page-link habit-pagination-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-searchString="@ViewBag.SearchString"
                       asp-route-status="@ViewBag.Status">

                        @i

                    </a>

                </li>
            }


            <!-- Next -->

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">

                <a class="page-link habit-pagination-link"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-searchString="@ViewBag.SearchString"
                   asp-route-status="@ViewBag.Status">

                    Next

                </a>

            </li>

        </ul>

    </nav>
}