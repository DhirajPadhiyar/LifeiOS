@model LifeiOS.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="page-header mb-30">

    <h1>Dashboard</h1>

    <p>
        Welcome back! Here's an overview of your LifeiOS.
    </p>

</div>
<div class="dashboard-stats">

    <div class="dashboard-summary-grid">

        <div class="summary-card">
                <div class="summary-icon summary-primary">
                    <i class="bi bi-check2-square"></i>
                </div>
            <div class="summary-content">
                <h6>Total Tasks</h6>
                <h2>@Model.TotalTasks</h2>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon summary-success">
                <i class="bi bi-journal-text"></i>
            </div>
            <div class="summary-content">
                <h6>Notes</h6>
                <h2>@Model.TotalNotes</h2>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon summary-warning">
                <i class="bi bi-bullseye"></i>
            </div>
            <div class="summary-content">
                <h6>Goals</h6>
                <h2>@Model.TotalGoals</h2>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon summary-danger">
                <i class="bi bi-wallet2"></i>
            </div>
            <div class="summary-content">
                <h6>Expenses</h6>
                <h2>₹@Model.TotalExpensesThisMonth.ToString("N0")</h2>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon summary-info">
                <i class="bi bi-activity"></i>
            </div>
            <div class="summary-content">
                <h6>Habits</h6>
                <h2>@Model.TotalHabits</h2>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon summary-secondary">
                <i class="bi bi-calendar-event"></i>
            </div>
            <div class="summary-content">
                <h6>Events</h6>
                <h2>@Model.TotalEvents</h2>
            </div>
        </div>

    </div>

</div>
<div class="card-custom mt-10">

    <div class="card-header-custom">

        <h3 class="card-title-custom">
            Quick Actions
        </h3>

    </div>

    <div class="card-body-custom">

        <div class="quick-actions">

            <a asp-controller="Tasks"
               asp-action="Create"
               class="quick-action">

                <i class="bi bi-plus-square"></i>

                <span>Add Task</span>

            </a>

            <a asp-controller="Notes"
               asp-action="Create"
               class="quick-action">

                <i class="bi bi-journal-plus"></i>

                <span>Add Note</span>

            </a>

            <a asp-controller="Goals"
               asp-action="Create"
               class="quick-action">

                <i class="bi bi-bullseye"></i>

                <span>Add Goal</span>

            </a>

            <a asp-controller="Expenses"
               asp-action="Create"
               class="quick-action">

                <i class="bi bi-wallet2"></i>

                <span>Add Expense</span>

            </a>

        </div>

    </div>

</div>
<div class="dashboard-chart-grid mt-30">

    <!-- Task Chart -->

    <div class="card-custom dashboard-panel panel-primary">

        <div class="card-header-custom">

            <h3 class="card-title-custom">
                Task Status
            </h3>

        </div>

        <div class="dashboard-chart">
            <canvas id="taskChart"></canvas>
        </div>

    </div>

    <!-- Expense Chart -->

    <div class="card-custom dashboard-panel panel-primary">

        <div class="card-header-custom">

            <h3 class="card-title-custom">
                Monthly Expenses
            </h3>

        </div>

        <div class="dashboard-chart">
            <canvas id="expenseChart"></canvas>
        </div>

    </div>

</div>
<div class="dashboard-widget-grid mt-30">

    <!-- Recent Tasks -->

    <div class="card-custom dashboard-panel panel-primary">

        <div class="card-header-custom">

            <h3 class="card-title-custom">
                Recent Tasks
            </h3>

        </div>

        <div class="card-body-custom">

            <ul class="dashboard-list">

                @if (Model.RecentTasks.Any())
                {
                    @foreach (var task in Model.RecentTasks)
                    {
                        <li>

                            @if (task.IsCompleted)
                            {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            }
                            else
                            {
                                <i class="bi bi-clock text-warning"></i>
                            }

                            <span>@task.Title</span>

                        </li>
                    }
                }
                else
                {
                    <li class="text-muted">
                        No tasks found.
                    </li>
                }

            </ul>
            <div class="dashboard-section-header">
                <a asp-controller="Tasks"
                   asp-action="Index"
                   class="dashboard-view-all">
                    View All
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>

        </div>

    </div>

    <!-- Latest Notes -->

    <div class="card-custom dashboard-panel panel-primary">

        <div class="card-header-custom">

            <h3 class="card-title-custom">
                Latest Notes
            </h3>

        </div>

        <div class="card-body-custom">

            <ul class="dashboard-list">

                @if (Model.LatestNotes.Any())
                {
                    @foreach (var note in Model.LatestNotes)
                    {
                        <li>
                            <i class="bi bi-journal-text text-primary"></i>
                            <span>@note.Title</span>
                        </li>
                    }
                }
                else
                {
                    <li class="text-muted">
                        No notes available.
                    </li>
                }

            </ul>
            <div class="dashboard-section-header">
                <a asp-controller="Notes"
                   asp-action="Index"
                   class="dashboard-view-all">
                    View All
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>
        </div>

    </div>

</div>
<div class="dashboard-widget-grid mt-30">

    <!-- Goal Progress -->

    <div class="card-custom dashboard-panel panel-primary">

        <div class="card-header-custom">

            <h3 class="card-title-custom">
                Goal Progress
            </h3>

        </div>

        <div class="card-body-custom">

            @if (Model.Goals.Any())
            {
                @foreach (var goal in Model.Goals)
                {
                    <div class="progress-item">

                        <div class="progress-header">

                            <span>@goal.GoalTitle</span>

                            <span>@goal.Progress%</span>

                        </div>

                        @if (goal.TargetValue > 0)
                        {
                            <div class="goal-progress-values">

                                <span>
                                    @goal.CurrentValue.ToString("N0")
                                </span>

                                <span class="goal-separator">/</span>

                                <span>
                                    @(goal.TargetValue?.ToString("N0") ?? "0")
                                </span>

                            </div>
                        }
                        <div class="progress-bar-custom">

                            <div class="progress-fill
                                @(goal.Progress >= 80 ? "progress-success"
                                 : goal.Progress >= 40 ? "progress-warning"
                                 : "progress-danger")"
                                 style="width:@goal.Progress%;">
                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="dashboard-empty">

                    <i class="bi bi-bullseye"></i>

                    <p>No goals available.</p>

                </div>
            }

            <div class="dashboard-section-header">

                <a asp-controller="Goals"
                   asp-action="Index"
                   class="dashboard-view-all">

                    View All

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </div>

    </div>

    <!-- Today's Schedule -->

    <div class="card-custom dashboard-panel panel-primary">

        <div class="card-header-custom">

            <h3 class="card-title-custom">
                Today's Schedule
            </h3>
            <p class="dashboard-subtitle">

                @(Model.TodayEvents.Count) event(s) today

            </p>

        </div>

        <div class="card-body-custom">

            @if (Model.TodayEvents.Any())
            {
                <ul class="dashboard-list">

                    @foreach (var item in Model.TodayEvents)
                    {
                        <li>

                            <i class="bi bi-calendar-event text-primary"></i>

                            <span>

                                @if (item.IsAllDay)
                                {
                                    <strong>All Day</strong>
                                }
                                else
                                {
                                    @item.StartDate.ToString("hh:mm tt")
                                }

                                - @item.Title

                            </span>

                        </li>
                    }

                </ul>
            }
            else
            {
                <div class="dashboard-empty">

                    <i class="bi bi-calendar-x"></i>

                    <p>No events scheduled for today.</p>

                </div>
            }

            <div class="dashboard-section-header">

                <a asp-controller="Calendar"
                   asp-action="Index"
                   class="dashboard-view-all">

                    View All

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </div>

    </div>

</div>
@section Scripts {

    <script>

        const taskChart = document.getElementById('taskChart');

        new Chart(taskChart,{

            type:'doughnut',

            data:{

                labels:['Completed','Pending','Overdue'],

                datasets:[{

                            data:[
            @Model.CompletedTasks,
            @Model.PendingTasks,
            @Model.OverdueTasks
        ],

                    backgroundColor:[

                        '#22C55E',

                        '#F59E0B',

                        '#2563EB'

                    ]

                }]

            },

            options:{

                responsive:true,

                maintainAspectRatio:false

            }

        });

        const expenseChart=document.getElementById('expenseChart');

        new Chart(expenseChart,{

            type:'bar',

            data:{

        labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpenseMonths)),

                datasets:[{

                    label:'Expenses',

                    data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyExpenses)),

                    backgroundColor:'#2563EB',
                        borderRadius:8,

        maxBarThickness:40

                }]

            },

            options:{

                responsive:true,

                maintainAspectRatio:false,

                scales:{

                    y:{

                        beginAtZero:true

                    }

                }

            }

        });

    </script>

}
